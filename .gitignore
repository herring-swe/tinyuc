# CMake. Never commit user override's
CMakeUserPresets.json

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug symbols / program database (e.g. vc140.pdb from cl.exe)
*.pdb
*.ilk

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Bundled tool binaries (force-track even if .exe)
!/tools/clang-format/clang-format.exe

# Editor temp/backup files
*~
*.bak

# Python compiled files
*.pyc
